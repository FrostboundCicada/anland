<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false">

        <!-- Launcher entry: window list (Attached/Detached state) -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- wayland windows are hosted by com.anlandnext.awl.AwlWindowActivity,
             merged in from the libawl library module (same code third-party
             consumer apps run) -->

        <!-- Window behavior settings。anland.action.OPEN_SETTINGS 让额外按键栏的
             「设置」键能从 libawl 库模块里跨模块拉起（库不依赖 app 类）。 -->
        <activity android:name=".WlSettingsActivity" android:exported="true">
            <intent-filter>
                <action android:name="anland.action.OPEN_SETTINGS"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <!-- 硬件键拦截（对齐 anland5 的 KeyInterceptor）：Fn/F1-F12、Back→ESC -->
        <service
            android:name=".KeyInterceptor"
            android:exported="true"
            android:label="Anland KeyInterceptor"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>

        <!-- client closed its own window → daemon notification finishes the Activity -->
        <receiver android:name=".WindowGoneReceiver" android:exported="true">
            <intent-filter>
                <action android:name="anland.WINDOW_GONE"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
